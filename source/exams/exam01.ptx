<?xml version="1.0" encoding="UTF-8"?>

<worksheet>
  <title>Midterm 01</title>
  <introduction>
    <p>
      <alert>Instructions:</alert> All questions are equally weighted. Answer all questions.
    </p>
  </introduction>

  <page>
    <exercise>
      <task>
        <statement>

            <p>
                Let <m>X</m> be any non-empty set.
                Take <m>\M \subseteq \P(X)</m>.
                What properties must <m>\M</m> satisfy in order to be a <em>
                <m>\sigma</m>-algebra</em>?
            </p>

        </statement>
      </task>

      <task>
        <statement>
          <p>
              Let <m>X</m> be any set and let <m>\M</m> be a <m>\sigma</m>-algebra of
              subsets of <m>X</m>.
              Give the definition of a <em>measure</em> <m>\mu</m> on <m>(X,\M)</m>.
          </p>
        </statement>
      </task>

      <task>
        <statement>
            <p>
                Let <m>X</m> be a non-empty set.
                Fix a point <m>x_0\in X</m>.
                Define a function
                <md>
                    \delta_{x_0} \colon \P(X) \rightarrow [0,\infty],
                </md>
                by
                <md> \delta_{x_0}(A) = \begin{cases} 1 &amp;\text{if }x_0
                \in A;\\  0 &amp;\text{if }x_0 \notin A.
                \end{cases} </md>
                Show that <m>\delta_{x_0}</m> is a measure.
            </p>
        </statement>
      </task>
    </exercise>

    <exercise>
      <task>
        <statement>
          <p>
            Give the definition of an <em>outer measure</em>.
          </p>
        </statement>
      </task>

      <task>
        <statement>
            <p>
                Let <m>\mu^*</m> be an outer measure.
                Give the definition of a <em>measurable set</em> with respect to <m>\mu^*</m>.
            </p>
        </statement>
      </task>

      <task>
        <statement>
           <p>
               Let <m>X</m> be a set, and let <m>\S</m> be a collection of subsets of
               <m>\S</m>.
               Let <m>\mu \colon \S \rightarrow [0,\infty]</m> be a set function.
               Define the <em>outer measure induced by <m>\mu</m></em>.
           </p>
        </statement>
      </task>

      <task>
        <statement>
          <p>
              Let <m>X</m> be any non-empty set and let <m>\S =  \{\emptyset, X\}</m>
              define <m>\mu(\emptyset)=0</m> and <m>\mu(X)=1</m>.
              Determine the outer measure <m>\mu^*</m> induced by <m>\mu</m>.
              Describe the <m>\sigma</m>-algebra of <m>\mu^*</m>-measurable sets.
          </p>
        </statement>
      </task>
    </exercise>

