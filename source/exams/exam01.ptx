    <exercise>
      <task>
        <statement>
            <p>
                Give the definition of the Borel sets in <m>\bR</m>.
            </p>
        </statement>
      </task>
      <task>
        <statement>
            <p>
                Let <m>\nu</m> be a Borel measure on a closed interval <m>[a,b]</m>.
                Give the definition of the <em>cumulative distribution</em> function for
                <m>\nu</m>.
            </p>
        </statement>
      </task>

      <task>
        <statement>
          <p>
              Let <m>m</m> be the Lebesgue measure on <m>[0,1]</m> restricted to the Borel sets.
              Define a Borel measure <m>\nu</m> on <m>[0,1]</m> by
              <md>
                \nu(E) = \frac{1}{2}m(E \cap [0,1/2)) + \frac{1}{3}m(E \cap [1/2,1]),
              </md>
              for all Borel sets <m>E \subseteq [0,1].</m>
              Describe the cumulative distribution function <m>g_\nu</m> of <m>\nu</m>.
          </p>
        </statement>
      </task>
    </exercise>

    <exercise>
    <introduction>
      <p>
        Let <m>(X,\M)</m> be a measurable space.
      </p>
    </introduction>
      <task>
        <statement>
          <p>
            Give the definition of a <em>signed measure</em> <m>\nu</m> on <m>(X,\M).</m>
          </p>
        </statement>
      </task>

      <task>
        <statement>
          <p>
            Let <m>\nu</m> be a signed measure on <m>(X,\M).</m>
            Give the definition of <em><m>\nu</m>-positive sets</em>; <em><m>\nu</m>-negative sets</em>; and <em><m>\nu</m>-mull sets.</em>
          </p>
        </statement>
      </task>

      <task>
        <statement>
          <p>
            Let <m>\mu_1</m> and <m>\mu_2</m> be two finite measures on <m>(X,\M)</m>.
            Show that <m>\nu = \mu_1 - \mu_2</m> defines a signed measure on <m>(X,\M)</m>.
          </p>
        </statement>
      </task>
    </exercise>
  </page>
</worksheet>